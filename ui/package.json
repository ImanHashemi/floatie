{
  "name": "floatie-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "typecheck": "node scripts/check-toolchain.mjs && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/check-toolchain.mjs && node -e \"require('node:fs').rmSync('.test-build', {recursive:true, force:true})\" && tsc -p tsconfig.test.json && node --test \".test-build/**/*.test.js\"",
    "check-dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2"
  }
}
