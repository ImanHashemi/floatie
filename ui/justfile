# Contributor commands only. Runtime floatie never installs or builds the UI.

install:
    node scripts/check-toolchain.mjs
    npm ci --ignore-scripts
    uv sync --locked
    uv python install "$(cat .python39-version)"
    uv run --locked python -m playwright install chromium

build:
    npm run build

typecheck:
    npm run typecheck

test:
    #!/usr/bin/env bash
    set -euo pipefail
    npm test
    compatibility_python="${FLOATIE_TEST_PYTHON39:-}"
    if [ -z "$compatibility_python" ]; then
      compatibility_python="$(uv python find --no-project --managed-python --no-python-downloads "$(cat .python39-version)")"
    fi
    export FLOATIE_TEST_PYTHON39="$compatibility_python"
    uv run --locked python -m pytest -q ../tests/test_ui_assets.py ../tests/test_ui_build.py ../tests/test_ui_process.py ../tests/test_ui_lifecycle.py ../tests/test_server.py

test-browser:
    cd .. && uv run --locked --project ui python -m pytest -q tests/test_agent_ux.py tests/test_playwright.py tests/test_settings_browser.py tests/test_ui_polling.py tests/test_worker_commands.py tests/test_workspace_acceptance.py tests/test_workspace_browser.py tests/test_workspace_review.py tests/test_ui_shell.py tests/test_ui_integration.py

check-dist:
    npm run check-dist
